# Loaded automatically by `npm run build`. Empty means "same origin": the
# reverse proxy serves this bundle and forwards /api/* to the backend, so no
# cross-origin request — and therefore no CORS entry — is involved.
#
# Override only if the API is deployed to a different origin, e.g.
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
