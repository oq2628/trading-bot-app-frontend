# Origin of the backend API, WITHOUT a trailing slash.
#
# Leave empty in production: the reverse proxy serves this app and forwards
# /api/* to the backend, so requests stay same-origin and no CORS entry is
# needed. Set it only when the API lives on a different origin.
#
#   production (behind the reverse proxy):  VITE_API_BASE_URL=
#   local development against uvicorn:      VITE_API_BASE_URL=http://localhost:8000
#
# `npm run build` fails if this variable is not defined at all, so a bundle can
# never ship with the development default compiled in.
VITE_API_BASE_URL=http://localhost:8000
